# April Store - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.

# -------------------------------------------------------------
# Google Gemini AI Integration (Required for AI features)
# -------------------------------------------------------------
# Powers the AI Style Concierge, Smart Semantic Search, and Bank Receipt OCR
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Base application URL (e.g., http://localhost:3000 for local development)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Firebase Web Client (Authentication & Cloud Firestore)
# -------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Web Apps:
# https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# -------------------------------------------------------------
# Sanity Studio CMS Configuration
# -------------------------------------------------------------
# Obtain from Sanity Management: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-01-01"

# Sanity Write Token (Required for creating & modifying products via API)
# Create with 'Editor' or 'Administrator' rights under API > Tokens in Sanity Manage
SANITY_API_TOKEN=""

# -------------------------------------------------------------
# Web3Forms Configuration (Contact & Showcase Client Inquiries)
# -------------------------------------------------------------
# Obtain free access key from: https://web3forms.com/
NEXT_PUBLIC_WEB3FORMS_API_KEY=""

# -------------------------------------------------------------
# Search Engine & Webmaster Verification (Optional)
# -------------------------------------------------------------
# Google Search Console HTML Verification Tag (token from search.google.com)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

